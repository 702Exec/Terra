[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/threat_markers.gd" id="2_threat"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="ThreatMarkers" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_threat")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Readout" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 40

[node name="WaveLabel" type="Label" parent="Margin/Rows/Readout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 26
text = "WAVE  —"

[node name="BaseLabel" type="Label" parent="Margin/Rows/Readout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 26
text = "BASE  — / —"

[node name="CreditsLabel" type="Label" parent="Margin/Rows/Readout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 26
text = "CREDITS  —"

[node name="PlacementLabel" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text = "Click the ground to place a turret"

[node name="WarningLabel" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 0.34
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.72, 0.2, 1)
